((author "Peter McGoron")
 (version "0.2.1")
 (synopsis "Supplemental Numerics (includes complex hyperbolic functions)")
 (category math)
 (license "MIT")
 (test-dependencies test srfi-144)
 (dependencies srfi-144)
 (components (extension srfi-278
               (source "lib/srfi/278.sld")
               (source-dependencies "lib/srfi/278.scm")
               ; exact-integer-nth-root is built in
               (source-dependencies "lib/srfi/278.exact-integer-log.scm")
               (csc-options "-O3")
               )
             ))
